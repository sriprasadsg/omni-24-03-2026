/*!
 * Real-time WebSocket client (Socket.IO / Engine.IO v4 protocol).
 * Connects to the platform backend, receives 'command' events,
 * and reconnects automatically on disconnect.
 *
 * Protocol framing:
 *   Engine.IO packets: 0=OPEN, 2=PING, 3=PONG, 4=MESSAGE
 *   Socket.IO packets: 0=CONNECT, 2=EVENT  → "40" = SIO_CONNECT, "42" = SIO_EVENT
 */
use std::{sync::{Arc, atomic::{AtomicBool, Ordering}}, time::Duration};
use futures_util::{SinkExt, StreamExt};
use serde_json::{json, Value};
use tokio::sync::RwLock;
use tokio_tungstenite::{connect_async, tungstenite::Message};

use crate::config::Config;

pub async fn ws_client(cfg: Arc<RwLock<Config>>, running: Arc<AtomicBool>) {
    loop {
        if !running.load(Ordering::Relaxed) { return; }

        let (base, agent_id, token) = {
            let c = cfg.read().await;
            match (&c.agent_id, &c.agent_token) {
                (Some(id), Some(tok)) => (c.api_base_url.trim_end_matches('/').to_string(), id.clone(), tok.clone()),
                _ => { tokio::time::sleep(Duration::from_secs(5)).await; continue; }
            }
        };

        let ws_base = base.replacen("http://", "ws://", 1).replacen("https://", "wss://", 1);
        let url = format!("{ws_base}/socket.io/?EIO=4&transport=websocket");

        match connect_async(&url).await {
            Ok((mut ws, _)) => {
                crate::olog!("WS connected to {ws_base}");

                // Wait for Engine.IO OPEN packet (starts with '0')
                let mut sio_connected = false;
                if let Ok(Some(Ok(Message::Text(pkt)))) =
                    tokio::time::timeout(Duration::from_secs(5), ws.next()).await
                {
                    if pkt.starts_with('0') {
                        // Send Socket.IO CONNECT with auth — tenant_id derived from JWT by server
                        let auth = json!({
                            "token": token, "type": "agent", "agent_id": agent_id
                        });
                        let _ = ws.send(Message::Text(format!("40{auth}").into())).await;
                        sio_connected = true;
                    }
                }

                if !sio_connected {
                    tokio::time::sleep(Duration::from_secs(10)).await;
                    continue;
                }

                // Main receive loop
                while running.load(Ordering::Relaxed) {
                    match tokio::time::timeout(Duration::from_secs(60), ws.next()).await {
                        Ok(Some(Ok(Message::Text(pkt)))) => {
                            if pkt == "2" {
                                // Engine.IO PING → respond with PONG
                                let _ = ws.send(Message::Text("3".to_string().into())).await;
                            } else if let Some(payload) = pkt.strip_prefix("42") {
                                // Socket.IO EVENT
                                if let Ok(Value::Array(arr)) = serde_json::from_str::<Value>(payload) {
                                    if arr.len() >= 2 {
                                        let event = arr[0].as_str().unwrap_or("");
                                        handle_event(event, &arr[1], &cfg, &mut ws).await;
                                    }
                                }
                            }
                        },
                        Ok(Some(Ok(Message::Ping(d)))) => { let _ = ws.send(Message::Pong(d)).await; },
                        Ok(None) | Err(_) => break,
                        Ok(Some(Err(_))) => break,
                        _ => {}
                    }
                }
                crate::olog!("WS disconnected — reconnecting in 5 s");
            },
            Err(e) => {
                crate::olog!("WS connect error: {e} — retry in 15 s");
                tokio::time::sleep(Duration::from_secs(15)).await;
                continue;
            }
        }

        if running.load(Ordering::Relaxed) {
            tokio::time::sleep(Duration::from_secs(5)).await;
        }
    }
}

async fn handle_event(
    event: &str,
    data: &Value,
    cfg: &Arc<RwLock<Config>>,
    ws: &mut (impl SinkExt<Message, Error = tokio_tungstenite::tungstenite::Error> + Unpin),
) {
    match event {
        "command" => {
            let cmd_id  = data.get("id").and_then(|v| v.as_str()).unwrap_or("").to_string();
            let command = data.get("command").and_then(|v| v.as_str()).unwrap_or("");
            let shell   = data.get("shell").and_then(|v| v.as_str()).unwrap_or("powershell");
            if command.is_empty() { return; }

            crate::olog!("WS command [{shell}]: {}", &command[..command.len().min(80)]);
            let (out, code) = run_shell(shell, command).await;

            let result = json!(["command_result", { "cmd_id": cmd_id, "output": out, "exit_code": code }]);
            let _ = ws.send(Message::Text(format!("42{result}").into())).await;
        },
        "ping" => { let _ = ws.send(Message::Text("42[\"pong\",{}]".to_string().into())).await; },
        "chat_message" => {
            let text = data.get("text").and_then(|v| v.as_str()).unwrap_or("");
            crate::olog!("WS chat: {text}");
            let _ = cfg.read().await; // keep borrow checker satisfied
        },
        _ => {}
    }
}

async fn run_shell(shell: &str, cmd: &str) -> (String, i32) {
    let result = if shell == "cmd" {
        tokio::process::Command::new("cmd").args(["/c", cmd]).output().await
    } else {
        tokio::process::Command::new("powershell")
            .args(["-NoProfile", "-NonInteractive", "-Command", cmd]).output().await
    };
    match result {
        Ok(o) => {
            let out = format!("{}{}", String::from_utf8_lossy(&o.stdout), String::from_utf8_lossy(&o.stderr));
            (out.trim().to_string(), o.status.code().unwrap_or(-1))
        },
        Err(e) => (e.to_string(), -1),
    }
}
