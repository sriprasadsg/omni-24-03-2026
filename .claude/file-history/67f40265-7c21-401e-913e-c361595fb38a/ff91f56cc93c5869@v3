[package]
name = "omni-agent"
version = "2.0.0"
edition = "2021"
description = "Enterprise OmniAgent — Rust edition"

[[bin]]
name = "omni-agent"
path = "src/main.rs"

[dependencies]
# native-tls → uses Schannel on Windows (pure Rust, no NASM/OpenSSL needed for cross-compilation)
reqwest = { version = "0.11", default-features = false, features = ["json", "native-tls"] }
tokio   = { version = "1",    features = ["rt-multi-thread", "macros", "time"] }
serde      = { version = "1", features = ["derive"] }
serde_json = "1"
serde_yaml = "0.9"
sysinfo    = "0.30"
chrono          = "0.4"
windows-service = "0.7"

[profile.release]
opt-level    = "z"
lto          = true
panic        = "abort"
codegen-units = 1
