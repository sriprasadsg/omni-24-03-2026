"""
Windows agent installer builders.

Priority chain for each format:
  EXE  → makensis (NSIS)  → ZIP fallback
  MSI  → wixl (msitools)  → ZIP fallback

Install tools on the server:
    sudo apt-get install -y nsis msitools
"""

import asyncio
import logging
import os
import shutil
import tempfile
import uuid
import zipfile
from pathlib import Path
from typing import Optional

import yaml
from fastapi import BackgroundTasks, HTTPException
from fastapi.responses import Response

logger = logging.getLogger(__name__)

_AGENT_EXCLUDE = shutil.ignore_patterns(
    "__pycache__", "*.pyc", "*.key", "*.db", "*.log",
    "venv", ".venv", "node_modules", "dist", "build", "*.spec",
    "config.yaml",  # always written fresh with tenant credentials
)


# ── Shared helpers ─────────────────────────────────────────────────────────────

def _agent_src(base_dir: Path) -> Path:
    src = base_dir / "agent"
    if not src.is_dir():
        raise HTTPException(status_code=500, detail="Source agent directory not found on server")
    return src


def cleanup_temp_dir(path: str) -> None:
    try:
        shutil.rmtree(path, ignore_errors=True)
    except Exception as exc:
        logger.debug("temp dir cleanup failed: %s", exc)


def _config_yaml(api_url: str, registration_key: str) -> dict:
    return {
        "agent_id": None,
        "agent_token": None,
        "api_base_url": api_url,
        "interval_seconds": 30,
        "max_cpu_percent": 20,
        "agentic_mode_enabled": False,
        "registration_key": registration_key,
    }


async def _run(args: list, cwd: str, timeout: int = 300) -> bytes:
    """Run a subprocess; raise HTTPException on failure."""
    proc = await asyncio.create_subprocess_exec(
        *args,
        cwd=cwd,
        stdout=asyncio.subprocess.PIPE,
        stderr=asyncio.subprocess.PIPE,
    )
    try:
        _, stderr = await asyncio.wait_for(proc.communicate(), timeout=timeout)
    except (asyncio.TimeoutError, TimeoutError):
        raise HTTPException(status_code=503, detail=f"{args[0]} timed out after {timeout}s")
    if proc.returncode != 0:
        snippet = (stderr or b"").decode(errors="replace")[-500:]
        logger.error("%s failed:\n%s", args[0], snippet)
        raise HTTPException(status_code=503, detail=f"{args[0]} build failed: {snippet}")
    return stderr


# ── NSIS EXE builder ───────────────────────────────────────────────────────────

def _nsis_file_commands(pkg_dir: Path) -> str:
    """Walk pkg_dir and emit NSIS SetOutPath+File commands for every file."""
    lines: list[str] = []
    skip_dirs = {"__pycache__", "venv", ".venv", "node_modules", "dist", "build", ".git"}

    for root, dirs, files in os.walk(pkg_dir):
        dirs[:] = sorted(d for d in dirs if d not in skip_dirs)
        rel = os.path.relpath(root, pkg_dir)
        if rel == ".":
            install_path = "$INSTDIR"
        else:
            win_rel = rel.replace("/", "\\")
            install_path = f"$INSTDIR\\{win_rel}"

        payload = [f for f in files if not f.endswith(".pyc") and f not in {"buffer.db"}]
        if not payload:
            continue

        lines.append(f'  SetOutPath "{install_path}"')
        for fname in sorted(payload):
            abs_path = os.path.join(root, fname)
            lines.append(f'  File "{abs_path}"')

    return "\n".join(lines)


def _build_nsi_script(tenant_name: str, api_url: str, reg_key: str,
                      file_commands: str, outfile: str) -> str:
    # Escape for NSIS string context
    def esc(s: str) -> str:
        return s.replace('"', '$\\"')

    return f"""; OmniAgent Installer — auto-generated
!include "MUI2.nsh"
!include "LogicLib.nsh"

Name "OmniAgent 2.0 — {esc(tenant_name)}"
OutFile "{outfile}"
InstallDir "$PROGRAMFILES64\\OmniAgent"
RequestExecutionLevel admin
SetCompressor lzma

!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!define MUI_FINISHPAGE_TEXT "OmniAgent installed for {esc(tenant_name)}.$\\r$\\nThe agent starts automatically on next login."
!insertmacro MUI_PAGE_FINISH
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES
!insertmacro MUI_LANGUAGE "English"

!define UNINST "Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\OmniAgent"

Section "OmniAgent"
  SectionIn RO
  ExecWait 'schtasks /end /tn "OmniAgent"' $0
  ExecWait 'schtasks /delete /tn "OmniAgent" /f' $0

{file_commands}

  FileOpen  $0 "$INSTDIR\\config.yaml" w
  FileWrite $0 "api_base_url: {esc(api_url)}$\\r$\\n"
  FileWrite $0 "registration_key: {esc(reg_key)}$\\r$\\n"
  FileWrite $0 "agent_id: null$\\r$\\n"
  FileWrite $0 "agent_token: null$\\r$\\n"
  FileWrite $0 "interval_seconds: 30$\\r$\\n"
  FileWrite $0 "max_cpu_percent: 20$\\r$\\n"
  FileWrite $0 "agentic_mode_enabled: false$\\r$\\n"
  FileClose $0

  nsExec::ExecToLog 'cmd /c python -m pip install -r "$INSTDIR\\requirements.txt" --quiet 2>&1'
  ExecWait 'schtasks /create /tn "OmniAgent" /tr "pythonw \\"$INSTDIR\\agent.py\\"" /sc onlogon /ru SYSTEM /rl highest /f' $0
  ExecWait 'schtasks /run /tn "OmniAgent"' $0

  WriteRegStr   HKLM "${{UNINST}}" "DisplayName"     "OmniAgent"
  WriteRegStr   HKLM "${{UNINST}}" "DisplayVersion"  "2.0.0"
  WriteRegStr   HKLM "${{UNINST}}" "Publisher"       "Enterprise OmniAgent AI Platform"
  WriteRegStr   HKLM "${{UNINST}}" "InstallDir"      "$INSTDIR"
  WriteRegStr   HKLM "${{UNINST}}" "UninstallString" '"$INSTDIR\\Uninstall.exe"'
  WriteRegDWORD HKLM "${{UNINST}}" "NoModify" 1
  WriteRegDWORD HKLM "${{UNINST}}" "NoRepair" 1
  WriteUninstaller "$INSTDIR\\Uninstall.exe"
SectionEnd

Section "Uninstall"
  ExecWait 'schtasks /end /tn "OmniAgent"' $0
  ExecWait 'schtasks /delete /tn "OmniAgent" /f' $0
  RMDir /r "$INSTDIR"
  DeleteRegKey HKLM "${{UNINST}}"
SectionEnd
"""


async def build_exe(
    tenant_id: str, tenant_name: str, registration_key: str,
    api_url: str, background_tasks: BackgroundTasks, base_dir: Path,
) -> Response:
    """Build a Windows EXE installer using NSIS (makensis)."""
    makensis = shutil.which("makensis")
    if not makensis:
        raise HTTPException(
            status_code=503,
            detail="makensis not installed. Run: sudo apt-get install -y nsis",
        )

    agent_src = _agent_src(base_dir)
    tenant_safe = tenant_name.replace(" ", "-").lower()
    temp_dir = Path(tempfile.mkdtemp(prefix=f"omni_exe_{tenant_id}_"))
    try:
        pkg_dir = temp_dir / "pkg"
        shutil.copytree(agent_src, pkg_dir, ignore=_AGENT_EXCLUDE)

        file_cmds = _nsis_file_commands(pkg_dir)
        if not file_cmds.strip():
            raise HTTPException(status_code=500, detail="No agent files found to package")

        exe_out = temp_dir / f"OmniAgent-{tenant_safe}-Setup.exe"
        nsi_content = _build_nsi_script(tenant_name, api_url, registration_key,
                                        file_cmds, str(exe_out))
        nsi_path = temp_dir / "install.nsi"
        nsi_path.write_text(nsi_content, encoding="utf-8")

        logger.info("Building NSIS EXE for tenant %s (%s files)", tenant_id,
                    file_cmds.count('File "'))
        await _run([makensis, str(nsi_path)], cwd=str(temp_dir), timeout=300)

        if not exe_out.exists():
            raise HTTPException(status_code=503, detail="NSIS build produced no output file")

        content = exe_out.read_bytes()
        background_tasks.add_task(cleanup_temp_dir, str(temp_dir))
        return Response(
            content=content,
            media_type="application/octet-stream",
            headers={"Content-Disposition":
                     f'attachment; filename="OmniAgent-{tenant_safe}-Setup.exe"'},
        )
    except HTTPException:
        background_tasks.add_task(cleanup_temp_dir, str(temp_dir))
        raise
    except Exception as exc:
        logger.error("EXE build failed for %s: %s", tenant_id, exc)
        background_tasks.add_task(cleanup_temp_dir, str(temp_dir))
        raise HTTPException(status_code=500, detail="Failed to build Windows EXE installer")


# ── wixl MSI builder ───────────────────────────────────────────────────────────

def _generate_wxs(tenant_id: str, tenant_name: str, api_url: str,
                  reg_key: str, files_root: Path) -> str:
    skip_dirs = {"__pycache__", "venv", ".venv", "node_modules", "dist", "build", ".git"}

    # Collect all files with their relative paths
    entries: list[tuple[Path, Path]] = []
    for root, dirs, files in os.walk(files_root):
        dirs[:] = sorted(d for d in dirs if d not in skip_dirs)
        root_path = Path(root)
        rel_root = root_path.relative_to(files_root)
        for fname in sorted(files):
            if fname.endswith(".pyc") or fname in {"buffer.db"}:
                continue
            entries.append((root_path / fname, rel_root))

    # Stable GUIDs derived from tenant + relative path
    def file_guid(rel: str) -> str:
        return str(uuid.uuid5(uuid.NAMESPACE_URL, f"omni-{tenant_id}-{rel}")).upper()

    upgrade_guid = str(uuid.uuid5(uuid.NAMESPACE_URL, "omni-agent-upgrade-code")).upper()

    # Build directory elements (unique ID per subdirectory path)
    dir_ids: dict[str, str] = {}
    for _, rel_root in entries:
        parts = rel_root.parts
        for depth in range(len(parts)):
            key = str(Path(*parts[: depth + 1]))
            if key not in dir_ids:
                safe = key.replace("/", "_").replace("\\", "_").replace(".", "_").replace("-", "_")
                dir_ids[key] = f"Dir_{safe}"

    def dir_xml(parent_key: str = "", indent: int = 6) -> str:
        depth = len(parent_key.split("/")) if parent_key else 0
        out = ""
        for key, did in sorted(dir_ids.items()):
            parts = key.replace("\\", "/").split("/")
            if len(parts) != depth + 1:
                continue
            cur_parent = "/".join(parts[:-1])
            if cur_parent != parent_key:
                continue
            name = parts[-1]
            pad = " " * indent
            out += f'{pad}<Directory Id="{did}" Name="{name}">\n'
            out += dir_xml(key, indent + 2)
            out += f'{pad}</Directory>\n'
        return out

    # Build Component elements and Feature refs
    components = []
    refs = []
    for i, (abs_path, rel_root) in enumerate(entries):
        comp_id = f"Comp{i:05d}"
        file_id = f"File{i:05d}"
        rel_str = str(rel_root / abs_path.name)
        guid = file_guid(rel_str)
        dir_key = str(rel_root) if rel_root.parts else ""
        dir_id = dir_ids.get(dir_key, "INSTALLDIR")

        components.append(
            f'          <Component Id="{comp_id}" Guid="{{{guid}}}" Directory="{dir_id}">\n'
            f'            <File Id="{file_id}" Source="{abs_path}" Name="{abs_path.name}" KeyPath="yes"/>\n'
            f'          </Component>'
        )
        refs.append(f'        <ComponentRef Id="{comp_id}"/>')

    # Config CustomAction (PowerShell writes config.yaml after install)
    cfg_lines = (
        f"api_base_url: {api_url}`r`n"
        f"registration_key: {reg_key}`r`n"
        "agent_id: null`r`n"
        "agent_token: null`r`n"
        "interval_seconds: 30`r`n"
        "max_cpu_percent: 20`r`n"
        "agentic_mode_enabled: false`r`n"
    )
    ps_write_config = (
        f'powershell -NoProfile -NonInteractive -Command '
        f'"[IO.File]::WriteAllText([IO.Path]::Combine($env:ProgramFiles,\'OmniAgent\',\'config.yaml\'),'
        f'\'{cfg_lines}\')"'
    )
    ps_pip = (
        'powershell -NoProfile -NonInteractive -Command '
        '"python -m pip install -r ([IO.Path]::Combine($env:ProgramFiles,\'OmniAgent\',\'requirements.txt\')) --quiet"'
    )
    ps_task = (
        'powershell -NoProfile -NonInteractive -Command '
        '"schtasks /create /tn OmniAgent /tr (\'pythonw \\\'\' + [IO.Path]::Combine($env:ProgramFiles,\'OmniAgent\',\'agent.py\') + \'\\\'\') /sc onlogon /ru SYSTEM /rl highest /f"'
    )

    return f"""<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="{tenant_name} OmniAgent" Language="1033" Version="2.0.0"
           Manufacturer="Enterprise OmniAgent AI Platform" UpgradeCode="{{{upgrade_guid}}}">
    <Package InstallerVersion="300" Compressed="yes" InstallScope="perMachine" Platform="x64"/>
    <MediaTemplate EmbedCab="yes"/>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="OmniAgent">
{dir_xml('', 10)}
        </Directory>
      </Directory>
    </Directory>

    <Feature Id="Complete" Level="1">
{chr(10).join(refs)}
    </Feature>

{chr(10).join(components)}

    <CustomAction Id="WriteConfig"  Type="34" Directory="INSTALLDIR" ExeCommand='{ps_write_config}'/>
    <CustomAction Id="InstallDeps"  Type="34" Directory="INSTALLDIR" ExeCommand='{ps_pip}'/>
    <CustomAction Id="CreateTask"   Type="34" Directory="INSTALLDIR" ExeCommand='{ps_task}'/>

    <InstallExecuteSequence>
      <Custom Action="WriteConfig"  After="InstallFiles">NOT Installed</Custom>
      <Custom Action="InstallDeps"  After="WriteConfig">NOT Installed</Custom>
      <Custom Action="CreateTask"   After="InstallDeps">NOT Installed</Custom>
    </InstallExecuteSequence>
  </Product>
</Wix>
"""


async def build_msi(
    tenant_id: str, tenant_name: str, registration_key: str,
    api_url: str, background_tasks: BackgroundTasks, base_dir: Path,
) -> Response:
    """Build a Windows MSI installer using wixl (msitools)."""
    wixl = shutil.which("wixl")
    if not wixl:
        raise HTTPException(
            status_code=503,
            detail="wixl not installed. Run: sudo apt-get install -y msitools",
        )

    agent_src = _agent_src(base_dir)
    tenant_safe = tenant_name.replace(" ", "-").lower()
    temp_dir = Path(tempfile.mkdtemp(prefix=f"omni_msi_{tenant_id}_"))
    try:
        pkg_dir = temp_dir / "pkg"
        shutil.copytree(agent_src, pkg_dir, ignore=_AGENT_EXCLUDE)

        wxs_content = _generate_wxs(tenant_id, tenant_name, api_url, registration_key, pkg_dir)
        wxs_path = temp_dir / "install.wxs"
        wxs_path.write_text(wxs_content, encoding="utf-8")

        msi_out = temp_dir / f"OmniAgent-{tenant_safe}-Setup.msi"
        logger.info("Building wixl MSI for tenant %s", tenant_id)
        await _run([wixl, "-a", "x64", "-o", str(msi_out), str(wxs_path)],
                   cwd=str(temp_dir), timeout=300)

        if not msi_out.exists():
            raise HTTPException(status_code=503, detail="wixl produced no output file")

        content = msi_out.read_bytes()
        background_tasks.add_task(cleanup_temp_dir, str(temp_dir))
        return Response(
            content=content,
            media_type="application/octet-stream",
            headers={"Content-Disposition":
                     f'attachment; filename="OmniAgent-{tenant_safe}-Setup.msi"'},
        )
    except HTTPException:
        background_tasks.add_task(cleanup_temp_dir, str(temp_dir))
        raise
    except Exception as exc:
        logger.error("MSI build failed for %s: %s", tenant_id, exc)
        background_tasks.add_task(cleanup_temp_dir, str(temp_dir))
        raise HTTPException(status_code=500, detail="Failed to build Windows MSI installer")


# ── ZIP fallback (when neither NSIS nor wixl is installed) ────────────────────

async def build_windows_zip(
    tenant_id: str, tenant_name: str, registration_key: str,
    api_url: str, background_tasks: BackgroundTasks, base_dir: Path,
) -> Response:
    """Last-resort fallback: ZIP the Python agent with a PowerShell install script."""
    agent_src = _agent_src(base_dir)
    tenant_safe = tenant_name.replace(" ", "-").lower()
    temp_dir = Path(tempfile.mkdtemp(prefix=f"omni_win_{tenant_id}_"))
    try:
        agent_dest = temp_dir / "content" / "OmniAgent"
        shutil.copytree(agent_src, agent_dest, ignore=_AGENT_EXCLUDE)

        cfg = _config_yaml(api_url, registration_key)
        with open(agent_dest / "config.yaml", "w", encoding="utf-8") as f:
            yaml.dump(cfg, f, default_flow_style=False, sort_keys=True)

        ps = (
            f"# OmniAgent installer for {tenant_name}\r\n"
            "$AgentDir = \"C:\\OmniAgent\"\r\n"
            "$Src = Split-Path -Parent $MyInvocation.MyCommand.Path\r\n"
            "if (-not (Test-Path $AgentDir)) { New-Item -ItemType Directory -Path $AgentDir | Out-Null }\r\n"
            "Copy-Item -Path \"$Src\\OmniAgent\\*\" -Destination $AgentDir -Recurse -Force\r\n"
            "python -m pip install -r \"$AgentDir\\requirements.txt\" --quiet\r\n"
            "$nssm = Get-Command nssm -ErrorAction SilentlyContinue\r\n"
            "if ($nssm) { nssm install OmniAgent python \"$AgentDir\\agent.py\"; nssm start OmniAgent }\r\n"
            "else { schtasks /create /tn OmniAgent /tr \"pythonw `\"$AgentDir\\agent.py`\"\" /sc onlogon /ru SYSTEM /rl highest /f; schtasks /run /tn OmniAgent }\r\n"
            f"Write-Host 'OmniAgent installed. API: {api_url}'\r\n"
        )
        (temp_dir / "content" / "Install-OmniAgent.ps1").write_text(ps, encoding="utf-8")
        (temp_dir / "content" / "README.txt").write_text(
            f"OmniAgent for {tenant_name}\r\n"
            "Run Install-OmniAgent.ps1 as Administrator.\r\n"
            f"API URL: {api_url}\r\n", encoding="utf-8"
        )

        zip_base = str(temp_dir / f"OmniAgent-{tenant_safe}-windows")
        shutil.make_archive(zip_base, "zip", root_dir=str(temp_dir / "content"), base_dir=".")
        content = Path(f"{zip_base}.zip").read_bytes()

        background_tasks.add_task(cleanup_temp_dir, str(temp_dir))
        return Response(
            content=content,
            media_type="application/zip",
            headers={"Content-Disposition":
                     f'attachment; filename="OmniAgent-{tenant_safe}-windows.zip"'},
        )
    except HTTPException:
        background_tasks.add_task(cleanup_temp_dir, str(temp_dir))
        raise
    except Exception as exc:
        logger.error("Windows ZIP build failed for %s: %s", tenant_id, exc)
        background_tasks.add_task(cleanup_temp_dir, str(temp_dir))
        raise HTTPException(status_code=500, detail="Failed to build Windows agent package")
