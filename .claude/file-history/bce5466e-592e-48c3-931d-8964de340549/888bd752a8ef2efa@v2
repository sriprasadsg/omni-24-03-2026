```python
"""POST /api/powershell-evidence/submit — receives PowerShell compliance evidence."""
from fastapi import APIRouter, Header, HTTPException, Depends
from pydantic import BaseModel, Field
from typing import List, Optional
from database import get_database
from authentication_service import get_current_user, get_optional_user
from compliance_evidence_processor import process_automated_evidence
import logging

logger = logging.getLogger(__name__)
router = APIRouter()

_SUPER_ROLES = {"Super Admin", "super_admin", "admin", "platform-admin"}

class PSCheck(BaseModel):
    check: str = Field(..., min_length=1, max_length=200)
    status: str = Field(..., pattern=r"^(Pass|Fail|Warning|Error|N/A)$")
    details: str = Field("", max_length=2000)
    evidence_content: Optional[str] = Field(None, max_length=50000)
    content_hash: Optional[str] = Field(None, max_length=64)

class PSEvidencePayload(BaseModel):
    hostname: str = Field(..., min_length=1, max_length=253)
    asset_id: Optional[str] = None
    checks: List[PSCheck] = Field(..., min_length=1)
```

Auth resolution (in order):
1. `X-Registration-Key` header → look up `db._db.tenants.find_one({"registrationKey": key})`
2. `Authorization: Bearer <jwt>` → `get_optional_user()` → use `current_user.tenant_id`
3. Neither present → 401

After auth: call `process_automated_evidence(payload.hostname, {"checks": [c.dict() for c in payload.checks]}, db, agent_type="powershell", fallback_tenant_id=tenant_id)`.

Return: `{"accepted": len(payload.checks), "hostname": payload.hostname, "tenant_id": tenant_id}`

