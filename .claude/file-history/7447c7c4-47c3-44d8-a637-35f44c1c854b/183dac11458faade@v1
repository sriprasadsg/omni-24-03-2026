pub async fn install_patches(ids: &[String]) -> Value {
    let mut results = vec![];
    if ids.is_empty() {
        let out = crate::http::run_ps("winget upgrade --all --accept-package-agreements --accept-source-agreements 2>&1").await;
        results.push(json!({"type": "all_packages", "output": out}));
