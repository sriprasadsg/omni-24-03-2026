# ── Test 6: Get reviews sorted by date ─────────────────────────────────────────

def test_get_reviews_sorted_by_date():
    """GET /api/evidence/{id}/reviews → list sorted by created_at desc."""
    db = _make_mock_db()
    user = _make_user("tenant-a", "admin")
    client = _build_client(db, user)

