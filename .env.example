# ─────────────────────────────────────────────────────────────
# Enterprise Omni-Agent Platform — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── MongoDB ──────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/omniagent
MONGO_DB_NAME=omniagent

# ── JWT Authentication ────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=8

# ── Backend Server ────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=5000
DEBUG=false

# ── Frontend ──────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:5000
VITE_WS_URL=ws://localhost:5000

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── NVD CVE Sync (https://nvd.nist.gov/developers/request-an-api-key) ──
NVD_API_KEY=
NVD_SYNC_INTERVAL_HOURS=24

# ── Okta SIEM Ingest ─────────────────────────────────────────
OKTA_DOMAIN=your-org.okta.com
OKTA_API_TOKEN=
OKTA_POLL_INTERVAL_SECONDS=60

# ── Azure Defender / Sentinel ─────────────────────────────────
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=
AZURE_SENTINEL_WORKSPACE_ID=
AZURE_SENTINEL_WORKSPACE_KEY=

# ── GCP Security Command Center ───────────────────────────────
# Paste the full JSON content of your service account key (single line, escaped)
GCP_SERVICE_ACCOUNT_JSON=
GCP_ORGANIZATION_ID=
GCP_PROJECT_ID=

# ── AWS CloudTrail Ingest ─────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_CLOUDTRAIL_S3_BUCKET=

# ── Syslog UDP Receiver ───────────────────────────────────────
SYSLOG_UDP_PORT=5140

# ── Email (SMTP) ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@omniagent.io

# ── Slack Notifications ───────────────────────────────────────
SLACK_WEBHOOK_URL=

# ── PagerDuty ─────────────────────────────────────────────────
PAGERDUTY_API_KEY=

# ── OpenAI / LLM ─────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── Redis (optional — for rate limiting & caching) ───────────
REDIS_URL=redis://localhost:6379

# ── Demo Mode ────────────────────────────────────────────────
# Set to true to enable synthetic data endpoints and skip live integrations
DEMO_MODE=true
SEED_DEMO_DATA_ON_STARTUP=false
