# ─────────────────────────────────────────────────────────────
# Enterprise Omni-Agent Platform — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── MongoDB ──────────────────────────────────────────────────
# Backend reads MONGODB_URL and MONGODB_DB_NAME
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=omni_platform

# ── JWT Authentication ────────────────────────────────────────
# Backend reads JWT_SECRET_KEY (not JWT_SECRET)
JWT_SECRET_KEY=change-me-to-a-long-random-secret-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Backend Server ────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=5000
DEBUG=false

# ── Frontend ──────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:5000
VITE_WS_URL=ws://localhost:5000

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── NVD CVE Sync (https://nvd.nist.gov/developers/request-an-api-key) ──
NVD_API_KEY=
NVD_SYNC_INTERVAL_HOURS=24

# ── Okta SIEM Ingest ─────────────────────────────────────────
OKTA_DOMAIN=your-org.okta.com
OKTA_API_TOKEN=
OKTA_POLL_INTERVAL_SECONDS=60

# ── Azure Defender / Sentinel ─────────────────────────────────
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=
AZURE_SENTINEL_WORKSPACE_ID=
AZURE_SENTINEL_WORKSPACE_KEY=

# ── GCP Security Command Center ───────────────────────────────
# Paste the full JSON content of your service account key (single line, escaped)
GCP_SERVICE_ACCOUNT_JSON=
GCP_ORGANIZATION_ID=
GCP_PROJECT_ID=

# ── AWS CloudTrail Ingest ─────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_CLOUDTRAIL_S3_BUCKET=

# ── Syslog UDP Receiver ───────────────────────────────────────
SYSLOG_UDP_PORT=5140

# ── Email (SMTP) ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@omniagent.io

# ── Slack Notifications ───────────────────────────────────────
SLACK_WEBHOOK_URL=

# ── PagerDuty ─────────────────────────────────────────────────
PAGERDUTY_API_KEY=

# ── OpenAI / LLM ─────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── Google Gemini ─────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
# VITE_GEMINI_API_KEY removed — never expose AI API keys in the browser bundle.
# All Gemini/AI calls are proxied through /api/ai/test-connection and /api/ai-proxy.

# ── Ollama (local LLM) ────────────────────────────────────────
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
OLLAMA_URL=http://127.0.0.1:11434

# ── Payment Encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
PAYMENT_ENCRYPTION_KEY=your-fernet-key-here

# ── Redis (optional — for rate limiting & caching) ───────────
REDIS_URL=redis://localhost:6379

# ── Super Admin ───────────────────────────────────────────────
# Initial password for the built-in super-admin account (change immediately after first login)
SUPER_ADMIN_PASSWORD=change-me-to-a-strong-password

# ── Security Scanning ─────────────────────────────────────────
# VirusTotal API key (https://www.virustotal.com/gui/my-apikey)
VIRUSTOTAL_API_KEY=

# ── Demo Mode ────────────────────────────────────────────────
# Set to true to enable synthetic data endpoints and skip live integrations
DEMO_MODE=true
SEED_DEMO_DATA_ON_STARTUP=false
