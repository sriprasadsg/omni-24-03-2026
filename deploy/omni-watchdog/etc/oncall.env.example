# Install as /etc/omni-watchdog/oncall.env (root:omni-watchdog 0640). Contains secrets once filled in:
# never commit the filled-in file. Leave ONCALL_TYPE empty (or "none") for no on-call channel.
# "pagerduty" or "webhook" (or "none").
ONCALL_TYPE=
# PagerDuty Events API v2 integration (routing) key.
PAGERDUTY_ROUTING_KEY=
# Webhook receiving the alert as a POST.
WEBHOOK_URL=
# "json" (default), "slack" or "teams".
WEBHOOK_FORMAT=
# External dead-man ping URL (healthchecks.io or similar), hit after every successful run. Strongly
# recommended: it is the only alert that still works when this whole server is down.
HEARTBEAT_URL=
