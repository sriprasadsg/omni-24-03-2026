# ============================================================
# Enterprise Omni-Agent Platform — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# ── MongoDB ─────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=omni_agent_platform
# MongoDB auth (required when using docker-compose in production)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
MONGO_ROOT_USER=omniagent
MONGO_ROOT_PASSWORD=change_this_strong_password_in_production

# ── JWT Authentication ───────────────────────────────────────
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Redis auth (required when using docker-compose)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=change_this_strong_password_in_production
# Email encryption key — generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EMAIL_ENCRYPTION_KEY=

# ── LLM / AI Provider ───────────────────────────────────────
# Primary: Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
# Fallback: OpenAI
OPENAI_API_KEY=your_openai_api_key_here
# Which provider to use: gemini | openai | ollama
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
# Local Ollama URL (if using ollama)
OLLAMA_URL=http://localhost:11434

# ── Email / SMTP ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM_EMAIL=noreply@your-domain.com
SMTP_FROM_NAME=Omni-Agent Platform
SMTP_USE_TLS=true

# ── Stripe Payment Gateway ───────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# ── PayPal Payment Gateway ───────────────────────────────────
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox

# ── Razorpay Payment Gateway ─────────────────────────────────
# Configure via UI: Settings → Payments → Add Gateway (type: razorpay)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ── Square Payment Gateway ───────────────────────────────────
# Configure via UI: Settings → Payments → Add Gateway (type: square)
SQUARE_ACCESS_TOKEN=your_square_access_token
SQUARE_ENVIRONMENT=sandbox

# ── Google OAuth / SSO ───────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
SSO_REDIRECT_URI=http://localhost:5000/api/sso/google/callback

# ── SAML / Enterprise SSO ────────────────────────────────────
SAML_IDP_METADATA_URL=https://your-idp.com/metadata.xml
SAML_SP_ENTITY_ID=https://your-domain.com/api/sso/saml/metadata

# ── MFA Settings ─────────────────────────────────────────────
MFA_APP_NAME=Omni-Agent Platform
MFA_ISSUER=omni-agent

# ── Redis Cache ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
CACHE_TTL=300

# ── AWS / Cloud Integrations ─────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1

# ── Azure Integrations ───────────────────────────────────────
AZURE_CLIENT_ID=your_azure_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret
AZURE_TENANT_ID=your_azure_tenant_id
AZURE_SUBSCRIPTION_ID=your_subscription_id

# ── GCP Integrations ─────────────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GCP_PROJECT_ID=your_gcp_project_id

# ── Voice Bot (Google Speech + TTS) ──────────────────────────
GOOGLE_SPEECH_CREDENTIALS=/path/to/speech-service-account.json

# ── SAST / Security Scanning ─────────────────────────────────
SEMGREP_APP_TOKEN=your_semgrep_token
ZAP_API_KEY=your_owasp_zap_api_key
ZAP_BASE_URL=http://localhost:8080

# ── Ticketing Integrations ───────────────────────────────────
JIRA_URL=https://your-org.atlassian.net
JIRA_EMAIL=your_email@company.com
JIRA_API_TOKEN=your_jira_api_token
SERVICENOW_URL=https://your-instance.service-now.com
SERVICENOW_USER=admin
SERVICENOW_PASS=your_password
PAGERDUTY_API_KEY=your_pagerduty_key

# ── Security Scanning ─────────────────────────────────────────
# VirusTotal API key (https://www.virustotal.com/gui/my-apikey)
VIRUSTOTAL_API_KEY=

# ── Platform Settings ─────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
ENVIRONMENT=development
DEBUG=false
PORT=5000

# ── CORS / WebSocket Origins ──────────────────────────────────
# In development, LAN IPs are auto-detected — no change needed.
# Override with a comma-separated list of allowed origins, or '*' to allow all.
# Example: SOCKETIO_CORS_ORIGINS=http://192.168.1.100:3000,http://10.0.0.5:3000
# SOCKETIO_CORS_ORIGINS=
# CORS_ORIGINS=

# ── Encryption Keys ────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_ENCRYPTION_KEY=your-fernet-key-here
PLATFORM_ADMIN_REG_KEY=your-stable-registration-key-here
SUPER_ADMIN_PASSWORD=your-secure-super-admin-password
