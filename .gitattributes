# Normalize all text files to LF on commit, regardless of OS
* text=auto eol=lf

# Explicitly LF
*.py        text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.json      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.md        text eol=lf
*.toml      text eol=lf
*.ini       text eol=lf
*.cfg       text eol=lf
*.env       text eol=lf
*.env.*     text eol=lf
*.sh        text eol=lf
*.conf      text eol=lf
*.nginx     text eol=lf
Makefile    text eol=lf
Dockerfile* text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.svg       text eol=lf

# Binary — never touch line endings
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.eot    binary
*.pdf    binary
*.zip    binary
*.exe    binary
*.msi    binary
*.dll    binary
*.pyc    binary
*.key    binary
